# =============================================================================
# Lead Finder Agent - environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and edit the values you need:
#
#     cp .env.example .env
#
# The project works with ZERO configuration and no paid services. Every value
# below is optional and only needed if you enable the matching provider or
# feature. NEVER commit your real `.env` file - it is ignored by git.
# =============================================================================

# --- General -----------------------------------------------------------------
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LEAD_FINDER_LOG_LEVEL=INFO

# Where the SQLite database lives (relative paths resolve from the repo root).
LEAD_FINDER_DB_PATH=data/leads.db

# Default search country/city used when a CLI command omits them.
LEAD_FINDER_DEFAULT_COUNTRY=Yemen
LEAD_FINDER_DEFAULT_CITY=Aden

# Comma separated list of search providers to use, in order.
# Available out of the box: osm, sample, google_places
# google_places needs a key (see the bottom of this file) and is skipped
# automatically when the key is absent, so it is safe to leave in this list.
LEAD_FINDER_PROVIDERS=osm,sample

# --- HTTP / providers --------------------------------------------------------
# A descriptive User-Agent is mandatory for OpenStreetMap services and is good
# manners for every public API. Put a real contact here if you deploy this.
LEAD_FINDER_USER_AGENT=LeadFinderAgent/0.1 (+https://github.com/haidrahalatwi02-wq/Agent-Openhand-1)

# Network timeout in seconds for provider and website-check requests.
LEAD_FINDER_HTTP_TIMEOUT=12

# Retries for transient provider failures (0 = try once).
LEAD_FINDER_MAX_RETRIES=0

# --- Rules and configuration data --------------------------------------------
# Point these at your own copies to customise behaviour without editing code.
# Missing files fall back to the packaged defaults with a warning.
# See docs/configuration.md.

# Scoring rules (`.yaml` or `.json`).
LEAD_FINDER_SCORING_RULES=

# Business-type aliases mapped to OpenStreetMap tags (`.yaml` or `.json`).
LEAD_FINDER_BUSINESS_TYPES=

# Overpass (OpenStreetMap) API endpoint used by the `osm` provider.
LEAD_FINDER_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim (OpenStreetMap) geocoding endpoint used to resolve cities.
LEAD_FINDER_NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- OpenStreetMap / Overpass tuning -----------------------------------------
# The `osm` provider is free and needs NO API key, so there is no secret below.
# These settings only bound how hard the shared community endpoints are asked
# to work. Raise them with care: Overpass and Nominatim are donation-funded.
#
# Server-side query budget in seconds, declared inside the Overpass query.
# Lower it for snappier failures; raise it only if a large city times out.
LEAD_FINDER_OSM_OVERPASS_TIMEOUT=25

# Hard ceiling on how many raw elements are requested from Overpass, so one
# huge city cannot pull thousands of rows through a shared endpoint.
LEAD_FINDER_OSM_MAX_ELEMENTS=200

# Named elements are dropped (an unnamed OSM object is not a usable lead), so a
# query can return fewer rows than requested. Setting this above 1.0 fetches
# extra rows to compensate, at the cost of more work for the free service.
LEAD_FINDER_OSM_OVERSAMPLE=1.0

# --- Optional, paid or keyed providers ---------------------------------------
# These are NOT required. A provider whose key is missing is skipped with a
# clear reason, and every other provider still runs.
# Documented in docs/providers.md.

# --- Google Places (New) -----------------------------------------------------
# Real business discovery through Google's official Places API (New).
# Enable it with:  LEAD_FINDER_PROVIDERS=google_places,osm,sample
#
# This is a PAID, keyed API governed by Google's terms. Read
# docs/providers.md before using it in production.
#
# The key value is the only secret here: leave it empty in this template and
# set the real value in your git-ignored .env. Never commit it, and never paste
# it into a command you might share.
GOOGLE_PLACES_API_KEY=

# Which environment variable holds the key (defaults to GOOGLE_PLACES_API_KEY).
# Change this only if you keep the key under a different variable name.
LEAD_FINDER_GOOGLE_PLACES_KEY_ENV=

# Override the endpoint only for a proxy or a compatible API. Leave blank for
# the official endpoint.
LEAD_FINDER_GOOGLE_PLACES_ENDPOINT=

# Maximum result pages to request (1-3). Google caps pageSize at 20, and the
# provider never returns more results than --limit asks for.
LEAD_FINDER_GOOGLE_PLACES_MAX_PAGES=3

# Optional BCP-47 language hint for results, e.g. `en` or `ar`.
LEAD_FINDER_GOOGLE_PLACES_LANGUAGE=

# Optional: SerpAPI key (paid) for search-engine based discovery.
SERPAPI_API_KEY=

# Optional: a generic API key placeholder for a custom provider you add.
LEAD_FINDER_CUSTOM_API_KEY=
