# Environment variables for Lead Finder Agent
# Copy this file to .env and fill in your configuration

# API Keys and Authentication
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OSM_API_KEY=your_osm_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./lead_finder.db
DATABASE_ECHO=false

# Search Configuration
SEARCH_PROVIDER=osm
SEARCH_RADIUS_KM=5
MAX_RESULTS_PER_SEARCH=100

# Scoring Configuration
SCORING_STRATEGY=weighted
MIN_SCORE_THRESHOLD=0.5

# Output Configuration
OUTPUT_FORMAT=csv
OUTPUT_DIR=./exports

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/lead_finder.log
