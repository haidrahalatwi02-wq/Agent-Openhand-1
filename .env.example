# =============================================================================
# Lead Finder Agent - environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and edit the values you need:
#
#     cp .env.example .env
#
# The project works with ZERO configuration and no paid services. Every value
# below is optional and only needed if you enable the matching provider or
# feature. NEVER commit your real `.env` file - it is ignored by git.
# =============================================================================

# --- General -----------------------------------------------------------------
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LEAD_FINDER_LOG_LEVEL=INFO

# Where the SQLite database lives (relative paths resolve from the repo root).
LEAD_FINDER_DB_PATH=data/leads.db

# Default search country/city used when a CLI command omits them.
LEAD_FINDER_DEFAULT_COUNTRY=Yemen
LEAD_FINDER_DEFAULT_CITY=Aden

# Comma separated list of search providers to use, in order.
# Available out of the box: osm, sample
LEAD_FINDER_PROVIDERS=osm,sample

# --- HTTP / providers --------------------------------------------------------
# A descriptive User-Agent is mandatory for OpenStreetMap services and is good
# manners for every public API. Put a real contact here if you deploy this.
LEAD_FINDER_USER_AGENT=LeadFinderAgent/0.1 (+https://github.com/haidrahalatwi02-wq/Agent-Openhand-1)

# Network timeout in seconds for provider and website-check requests.
LEAD_FINDER_HTTP_TIMEOUT=12

# Retries for transient provider failures (0 = try once).
LEAD_FINDER_MAX_RETRIES=0

# --- Rules and configuration data --------------------------------------------
# Point these at your own copies to customise behaviour without editing code.
# Missing files fall back to the packaged defaults with a warning.
# See docs/configuration.md.

# Scoring rules (`.yaml` or `.json`).
LEAD_FINDER_SCORING_RULES=

# Business-type aliases mapped to OpenStreetMap tags (`.yaml` or `.json`).
LEAD_FINDER_BUSINESS_TYPES=

# Overpass (OpenStreetMap) API endpoint used by the `osm` provider.
LEAD_FINDER_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim (OpenStreetMap) geocoding endpoint used to resolve cities.
LEAD_FINDER_NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Optional, paid or keyed providers ---------------------------------------
# These are NOT required. They are read only if you wire in an extra provider.
# Documented in docs/providers.md.

# Optional: Google Places API key (paid) for richer business data.
GOOGLE_PLACES_API_KEY=

# Optional: SerpAPI key (paid) for search-engine based discovery.
SERPAPI_API_KEY=

# Optional: a generic API key placeholder for a custom provider you add.
LEAD_FINDER_CUSTOM_API_KEY=
